{
  "name": "unplugin-lightningcss",
  "type": "module",
  "version": "0.5.0",
  "packageManager": "pnpm@12.3.4",
  "description": "Lightning CSS integration for Vite, Rollup, esbuild, Webpack, Vue CLI, and more.",
  "author": "Kevin Deng <sxzz@sxzz.moe>",
  "license": "MIT",
  "funding": "https://github.com/sponsors/sxzz",
  "homepage": "https://github.com/unplugin/unplugin-lightningcss#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unplugin/unplugin-lightningcss.git"
  },
  "bugs": {
    "url": "https://github.com/unplugin/unplugin-lightningcss/issues"
  },
  "keywords": [
    "unplugin",
    "css",
    "rollup",
    "rolldown",
    "vite",
    "esbuild",
    "webpack",
    "rspack",
    "farm"
  ],
  "exports": {
    ".": "./dist/index.mjs",
    "./api": "./dist/api.mjs",
    "./esbuild": "./dist/esbuild.mjs",
    "./farm": "./dist/farm.mjs",
    "./rolldown": "./dist/rolldown.mjs",
    "./rollup": "./dist/rollup.mjs",
    "./rspack": "./dist/rspack.mjs",
    "./vite": "./dist/vite.mjs",
    "./webpack": "./dist/webpack.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
  },
  "scripts": {
    "lint": "eslint --cache .",
    "lint:fix": "pnpm run lint --fix",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsgo --noEmit",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "lightningcss": "^1.33.0",
    "unplugin": "^3.3.0"
  },
  "devDependencies": {
    "@sxzz/eslint-config": "^8.2.1",
    "@sxzz/prettier-config": "^2.3.2",
    "@sxzz/test-utils": "^0.5.18",
    "@types/node": "^26.1.1",
    "@types/rollup-plugin-css-only": "^3.1.3",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "^12.0.0",
    "eslint": "^10.7.0",
    "prettier": "^3.9.6",
    "rollup": "^4.62.2",
    "rollup-plugin-css-only": "^4.5.5",
    "tsdown": "^0.22.13",
    "tsdown-preset-sxzz": "^0.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "vue": "^3.5.40"
  },
  "prettier": "@sxzz/prettier-config"
}
